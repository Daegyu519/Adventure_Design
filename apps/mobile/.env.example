# 앱 환경 변수. 이 파일을 apps/mobile/.env 로 복사해서 값을 채운다(.env 는 git 에 넣지 않는다).
# Expo 는 프로젝트 루트(apps/mobile)의 .env 만 읽는다. 저장소 루트 .env 에 넣으면 앱은 값을 못 읽는다.
# EXPO_PUBLIC_ 값은 앱 번들에 들어간다. 서비스 키와 모델 키는 넣지 않는다.
# 값을 바꾼 뒤에는 `npx expo start -c` 로 다시 시작한다.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# 엔진 주소(예: http://localhost:8000). 비워 두면 앱은 mock 엔진(가짜 힌트)으로 돈다. 개발 중에는 콘솔 경고가 뜬다.
EXPO_PUBLIC_ENGINE_URL=
# 웹 푸시 구독용 공개키. 개인키는 엔진에만 둔다.
EXPO_PUBLIC_VAPID_PUBLIC_KEY=

# 타입 생성(npm run gen:db)은 이 파일이 아니라 루트 .env의 SUPABASE_PROJECT_REF를 쓴다.
# Supabase CLI 로그인이 필요하다: `npx supabase login` 또는 셸에 SUPABASE_ACCESS_TOKEN.
