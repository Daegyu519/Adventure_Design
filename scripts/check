#!/usr/bin/env bash
# 사용법: scripts/check   (worktree 어디서든)
# 있는 영역만 검사한다. 하나라도 실패하면 exit 1.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

# node_modules가 lockfile과 다르면(새 worktree, main을 합쳐 lock이 바뀜) npm ci로 다시 깐다.
npm_ready() { cmp -s "$1/package-lock.json" "$1/node_modules/.lock-stamp" || (cd "$1" && npm ci --silent && cp package-lock.json node_modules/.lock-stamp); }

# --locked: uv.lock이 pyproject와 어긋나면 조용히 고치지 않고 실패한다.
if [ -f engine/pyproject.toml ]; then (cd engine && uv run --locked pytest -q); fi
if [ -f supabase/package.json ]; then npm_ready supabase; (cd supabase && npm test --silent); fi
# 앱: 타입 → lint → 테스트 → 색 리터럴 금지(색은 useTheme().colors에서만: '#…'·`#…`·rgb(a)·hsl(a), __tests__ 제외). grep이 찾으면 그 줄을 보이고 실패한다.
if [ -f apps/mobile/package.json ]; then npm_ready apps/mobile; (cd apps/mobile && npx tsc --noEmit && npm run lint --silent && npm test --silent \
  && ! grep -rnE "['\"\`]#[0-9A-Fa-f]{3,8}([^0-9A-Za-z_]|\$)|(rgba?|hsla?)\(" app components lib --include='*.ts' --include='*.tsx' --exclude-dir=__tests__ 2>/dev/null); fi
if [ -f design/check_contrast.py ]; then python3 design/check_contrast.py; fi

# 프롬프트·모델 설정을 바꿨으면 정밀도가 baseline보다 낮을 때 실패.
if [ -f eval/run_eval.py ] && [ -n "$(git diff --name-only "$(git merge-base main HEAD)" -- engine/prompts engine/config/models.yaml)" ]; then
  [ -f eval/baseline.json ] || { echo "eval/baseline.json missing" >&2; exit 1; }
  if [ -f engine/pyproject.toml ]; then
    out="$(uv run --project engine python eval/run_eval.py --mock --json)"
  else
    out="$(python3 eval/run_eval.py --mock --json)"
  fi
  jq -e --slurpfile b eval/baseline.json '.precision >= $b[0].precision' <<<"$out" >/dev/null \
    || { echo "eval precision below baseline: $out" >&2; exit 1; }
fi
