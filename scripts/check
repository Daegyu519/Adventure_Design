#!/usr/bin/env bash
# 사용법: scripts/check   (worktree 어디서든)
# 있는 영역만 검사한다. 하나라도 실패하면 exit 1.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

# 새 worktree에는 node_modules가 없다.
npm_ready() { [ -d "$1/node_modules" ] || (cd "$1" && npm install --silent); }

if [ -f engine/pyproject.toml ]; then (cd engine && uv run pytest -q); fi
if [ -f supabase/package.json ]; then npm_ready supabase; (cd supabase && npm test --silent); fi
if [ -f apps/mobile/package.json ]; then npm_ready apps/mobile; (cd apps/mobile && npx tsc --noEmit); fi

# 프롬프트·모델 설정을 바꿨으면 정밀도가 baseline보다 낮을 때 실패.
if [ -f eval/run_eval.py ] && [ -n "$(git diff --name-only "$(git merge-base main HEAD)" -- engine/prompts engine/config/models.yaml)" ]; then
  [ -f eval/baseline.json ] || { echo "eval/baseline.json missing" >&2; exit 1; }
  if [ -f engine/pyproject.toml ]; then
    out="$(uv run --project engine python eval/run_eval.py --mock --json)"
  else
    out="$(python3 eval/run_eval.py --mock --json)"
  fi
  jq -e --slurpfile b eval/baseline.json '.precision >= $b[0].precision' <<<"$out" >/dev/null \
    || { echo "eval precision below baseline: $out" >&2; exit 1; }
fi
