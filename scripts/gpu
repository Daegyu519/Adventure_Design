#!/usr/bin/env bash
# 사용법: scripts/gpu up|down [--force]|status
# 로컬 SEED 1.5B(tone_hcx)를 학교 GPU 서버에서 쓸 때만 켠다.
#   up:     서버에 llama-server를 띄우고(가장 한가한 GPU 1장) 이 컴퓨터 127.0.0.1:11434로 ssh 터널을 연다.
#   down:   터널을 닫고 서버 프로세스를 끈다(공유 GPU 반납). 파일럿 엔진(tone-engine)이 떠 있으면 llama-server는 두고 터널만 닫는다(--force면 끈다).
#   status: 서버·터널·GPU 상태.
# 엔진은 USE_LOCAL_MODEL=1일 때 models.yaml의 local(base_url http://localhost:11434/v1)을 쓴다.
# 접속은 ~/.ssh/config의 Host(기본 tone-gpu, GPU_SSH로 바꿈), 키 인증만. 서버 한 번 준비는 README "학교 GPU 서버".
set -euo pipefail
H="${GPU_SSH:-tone-gpu}"; PORT="${GPU_PORT:-11434}"
case "$PORT" in ''|*[!0-9]*) echo "GPU_PORT must be a number" >&2; exit 2 ;; esac
SOCK="${TMPDIR:-/tmp}/tone-gpu-${USER:-me}.sock"
MODEL_ID=naver-hyperclovax/HyperCLOVAX-SEED-Text-Instruct-1.5B   # models.yaml tone_hcx의 local: 뒤 이름과 같아야 한다
remote() { ssh -o BatchMode=yes -o ConnectTimeout=10 "$H" "$@"; }
tunnel_up() { [ -S "$SOCK" ] && ssh -S "$SOCK" -O check "$H" 2>/dev/null; }

case "${1:-}" in
up)
  # 서버 쪽 시작 명령은 deploy/school-gpu/up.sh llm 한 곳에만 있다(stdin으로 보낸다. 서버 복사본에 의존하지 않음).
  remote "bash -s -- llm" < "$(dirname "$0")/../deploy/school-gpu/up.sh"
  # 남은 소켓 파일이 있으면 지운다(없으면 -M이 멀티플렉싱 없이 터널을 열어 down이 못 닫는다)
  tunnel_up || { rm -f "$SOCK"; ssh -f -N -M -S "$SOCK" -o BatchMode=yes -o ExitOnForwardFailure=yes -L "127.0.0.1:$PORT:127.0.0.1:11434" "$H"; }
  for _ in $(seq 60); do
    if curl -sf "http://127.0.0.1:$PORT/health" >/dev/null; then
      echo "ready: http://127.0.0.1:$PORT/v1  (engine: USE_LOCAL_MODEL=1)"; exit 0
    fi
    sleep 1
  done
  echo "llama-server not ready after 60s: scripts/gpu status, server log /root/tone-chat-llm/server.log" >&2; exit 1 ;;
down)
  tunnel_up && ssh -S "$SOCK" -O exit "$H" 2>/dev/null || true
  if [ "${2:-}" != --force ] && remote "tmux has-session -t tone-engine 2>/dev/null"; then
    echo "down: tunnel closed; tone-llm kept running because the pilot engine (tone-engine) uses it. Use 'down --force' to kill it anyway."
  else
    remote "tmux kill-session -t tone-llm 2>/dev/null || true"
    echo "down: tunnel closed, GPU released"
  fi ;;
status)
  remote "tmux has-session -t tone-llm 2>/dev/null && echo 'server: running' || echo 'server: stopped'; nvidia-smi --query-gpu=index,memory.used,utilization.gpu --format=csv,noheader"
  if tunnel_up; then echo "tunnel: open (127.0.0.1:$PORT)"; else echo "tunnel: closed"; fi
  curl -sf "http://127.0.0.1:$PORT/health" >/dev/null && echo "local :$PORT: ok" || echo "local :$PORT: not answering" ;;
*) echo "usage: $0 up|down [--force]|status" >&2; exit 2 ;;
esac
