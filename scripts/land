#!/usr/bin/env bash
# 사용법: (작업 worktree 안에서) scripts/land <TASK_ID>
# check 통과 + tasks.md 상태 완료 + 루트가 깨끗한 main 이면 main에 --no-ff로 합치고 정리한다.
set -euo pipefail

ID="${1:-}"
[[ "$ID" =~ ^[A-Za-z0-9-]+$ ]] || { echo "usage: scripts/land <TASK_ID>" >&2; exit 1; }
ACCT="${TONE_ACCOUNT:-a}"
[[ "$ACCT" == a || "$ACCT" == b ]] || { echo "TONE_ACCOUNT must be a or b" >&2; exit 1; }

ROOT="$(dirname "$(git rev-parse --path-format=absolute --git-common-dir)")"
WT="$(git rev-parse --show-toplevel)"
cd "$WT"
BRANCH="$(git rev-parse --abbrev-ref HEAD)"
CLAIM="$ROOT/.coord/claims/$ID"
fail() { echo "land: $*" >&2; exit 1; }

[ "$(cat "$CLAIM/branch" 2>/dev/null)" = "$BRANCH" ] || fail "$ID is not claimed for branch $BRANCH (run inside its worktree)"
[ -z "$(git status --porcelain)" ] || fail "worktree has uncommitted changes"

# main이 브랜치에 들어 있어야 check가 합친 결과 그대로를 검사한 것이 된다.
up_to_date() { git merge-base --is-ancestor main HEAD || fail "main has moved; run: git merge main (in this worktree) and re-check"; }
up_to_date

# check 출력은 merge 커밋 메시지에 붙인다. 종료 코드는 그대로 지킨다.
rc=0; CHECK_OUT="$("$WT/scripts/check" 2>&1)" || rc=$?
[ -z "$CHECK_OUT" ] || printf '%s\n' "$CHECK_OUT"
[ "$rc" -eq 0 ] || fail "scripts/check failed"

# tasks.md 표에서 첫 칸이 ID, 마지막 칸이 완료인 행
# LC_ALL=C 필수: macOS awk는 로케일 정렬(strcoll)로 비교해서 한글 "대기"=="완료"가 참이 된다.
# 표 행(| 로 시작, 칸 2개 이상)만 본다. 빈 줄은 NF=0이라 $(NF-1)에서 macOS awk가 죽는다.
LC_ALL=C awk -F'|' -v id="$ID" '
  !/^\|/ || NF < 3 { next }
  { a = $2; z = $(NF-1); gsub(/^ +| +$/, "", a); gsub(/^ +| +$/, "", z) }
  a == id && z == "완료" { found = 1 }
  END { exit !found }' docs/tasks.md || fail "$ID is not 완료 in docs/tasks.md"

# 한 번에 한 계정만 합친다. 1초 간격 최대 TONE_LOCK_TRIES(기본 60)회.
LOCK="$ROOT/.coord/merge.lock"
TRIES="${TONE_LOCK_TRIES:-60}"; got=0
for i in $(seq "$TRIES"); do
  if mkdir "$LOCK" 2>/dev/null; then got=1; break; fi
  if [ "$i" -lt "$TRIES" ]; then sleep 1; fi
done
# 못 잡았으면 남의 잠금이다. 건드리지 말고 멈춘다(trap도 아직 없다).
[ "$got" = 1 ] || fail "could not get $LOCK (stale? rmdir it)"
trap 'rmdir "$LOCK" 2>/dev/null' EXIT
trap 'exit 1' INT TERM

up_to_date   # 기다리는 사이 다른 계정이 main을 옮겼을 수 있다.

[ "$(git -C "$ROOT" rev-parse --abbrev-ref HEAD)" = main ] || fail "root checkout is not on main"
[ -z "$(git -C "$ROOT" status --porcelain)" ] || fail "root checkout is not clean"

MSG="land $ID ($BRANCH)

scripts/check passed
$(printf '%s\n' "$CHECK_OUT" | tail -40)"
git -C "$ROOT" merge --no-ff -q -m "$MSG" "$BRANCH" || { git -C "$ROOT" merge --abort 2>/dev/null; fail "merge failed, nothing merged"; }

echo "$(date +%Y-%m-%dT%H:%M:%S%z) | $ACCT | $ID | landed | $BRANCH | merged into main" >> "$ROOT/.coord/log.md"
cd "$ROOT"
rm -rf "$CLAIM"
git worktree remove --force "$WT"
git branch -d "$BRANCH" >/dev/null
echo "landed $ID. cd $ROOT"
