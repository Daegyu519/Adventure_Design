#!/usr/bin/env bash
# 사용법: scripts/deploy-school [--env FILE]
# 엔진(engine/, deploy/)을 학교 GPU 서버에 올리고 llm·engine·funnel을 켠다(README "배포").
#   --env FILE:    엔진 환경 파일을 서버 engine.env(권한 600)로 복사한다. 값은 출력하지 않는다.
set -euo pipefail
cd "$(dirname "$0")/.."
H="${GPU_SSH:-tone-gpu}"; B=/root/tone-chat-deploy
ENVF=""
while [ $# -gt 0 ]; do
  case "$1" in
    --env) [ $# -ge 2 ] || { echo "--env needs FILE" >&2; exit 2; }; ENVF="$2"; shift 2 ;;
    *) echo "usage: $0 [--env FILE]" >&2; exit 2 ;;
  esac
done
[ -z "$ENVF" ] || [ -f "$ENVF" ] || { echo "no such file: $ENVF" >&2; exit 2; }
[ -z "$(git status --porcelain -- engine deploy)" ] || { echo "uncommitted changes under engine/ or deploy/; commit first" >&2; exit 1; }
remote() { ssh -o BatchMode=yes -o ConnectTimeout=10 "$H" "$@"; }
up() { remote 'bash -s -- '"$1" < deploy/school-gpu/up.sh; }

git archive HEAD engine deploy | remote "set -e; rm -rf $B/app.new; mkdir -p $B/app.new; tar -x -C $B/app.new"
# 가상환경 안의 스크립트는 절대 경로를 품으므로 자리를 바꾼 뒤에 sync한다. 실패하면 되돌린다(이전 venv는 다시 sync가 필요할 수 있음).
remote "set -e; cd $B; rm -rf app.prev app.failed; [ -d app ] && mv app app.prev; mv app.new app
  cd app/engine && uv sync --locked --no-dev --python 3.11 || { cd $B; rm -rf app.failed; mv app app.failed; [ -d app.prev ] && mv app.prev app; echo 'uv sync failed; rolled back' >&2; exit 1; }"
echo "uploaded: HEAD $(git rev-parse --short HEAD)"

if [ -n "$ENVF" ]; then
  remote "umask 077; cat > $B/engine.env.new && chmod 600 $B/engine.env.new && mv $B/engine.env.new $B/engine.env" < "$ENVF"
  echo "engine.env updated"
fi
up llm   # llm 실패는 엔진 코드와 무관하므로 되돌리지 않는다(set -e로 여기서 멈춘다)
if ! up engine; then
  # 엔진이 안 뜨면 이전 app으로 되돌린다. 되돌린 코드의 venv는 자리가 바뀌었으므로 다시 sync한다.
  fail() { echo "ROLLBACK FAILED - engine may be down; run: ssh $H 'bash -s -- status' < deploy/school-gpu/up.sh" >&2; exit 1; }
  r=0; remote "[ -d $B/app.prev ]" || r=$?
  [ "$r" != 255 ] || { echo "ssh failed" >&2; fail; }
  [ "$r" = 0 ] || { echo "engine failed and no previous app to roll back to" >&2; exit 1; }
  remote "set -e; cd $B; mv app app.failed; mv app.prev app; cd app/engine; uv sync --locked --no-dev --python 3.11" && up engine || fail
  echo "rolled back to previous app (failed one kept as app.failed); engine healthy" >&2
  exit 1
fi
c=0; up funnel || c=$?   # 3·4는 사람이 할 일(Tailscale 로그인·Funnel 켜기). 건강한 코드는 되돌리지 않는다.
[ "$c" = 0 ] || echo "(funnel exit $c: see message above and README 배포; then rerun)" >&2
up status
exit "$c"
