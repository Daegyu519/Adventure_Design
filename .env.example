# 이 파일을 .env로 복사해서 값을 채운다. .env는 git에 넣지 않는다.
# 키를 채팅이나 커밋에 붙이지 않는다. 키가 없으면 FORCE_MOCK=1로 돌린다.

# 앱(EXPO_PUBLIC_*)은 여기 없다. Expo는 apps/mobile/.env 만 읽으므로 apps/mobile/.env.example 을 복사해 채운다.

# 엔진
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=
HOOK_SECRET=
NVIDIA_API_KEY=
# 합성 문장 평가에만 쓴다. 실제 대화 경로에는 쓰지 않는다.
GEMINI_API_KEY=
GITHUB_TOKEN=
LOCAL_API_KEY=
# 선택
USE_LOCAL_MODEL=
MODELS_PATH=
EXPO_ACCESS_TOKEN=
FORCE_MOCK=

# 엔진 웹 푸시 (VAPID). 공개키(EXPO_PUBLIC_VAPID_PUBLIC_KEY)는 apps/mobile/.env.example 에 있다.
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# 협업 스크립트(claim, land)는 셸 환경 변수로 읽는다. a 또는 b, 없으면 a.
TONE_ACCOUNT=

# 앱 DB 타입 생성용(npm run gen:db). 번들에 안 들어감
SUPABASE_PROJECT_REF=
