# 이 파일을 .env로 복사해서 값을 채운다. .env는 git에 넣지 않는다.
# 키를 채팅이나 커밋에 붙이지 않는다. 키가 없으면 FORCE_MOCK=1로 돌린다.

# 앱. EXPO_PUBLIC_ 값은 앱 번들에 들어간다. 서비스 키와 모델 키는 넣지 않는다.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_ENGINE_URL=
# 웹 푸시 구독용 공개키. 개인키는 엔진에만 둔다.
EXPO_PUBLIC_VAPID_PUBLIC_KEY=

# 엔진
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=
HOOK_SECRET=
NVIDIA_API_KEY=
# 합성 문장 평가에만 쓴다. 실제 대화 경로에는 쓰지 않는다.
GEMINI_API_KEY=
GITHUB_TOKEN=
LOCAL_API_KEY=
# 선택
EXPO_ACCESS_TOKEN=
FORCE_MOCK=

# 엔진 웹 푸시 (VAPID). 공개키는 위 앱 블록에 있다.
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# 협업 스크립트(claim, land)는 셸 환경 변수로 읽는다. a 또는 b, 없으면 a.
TONE_ACCOUNT=
